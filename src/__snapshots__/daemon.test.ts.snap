exports[`launchd: plist matches the snapshot 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by hx. hx start, hx update and the hx daemon rewrite this file, so local edits do not last. -->
<plist version="1.0">
  <dict>
    <key>Label</key><string>ai.let.hx-vision</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/me/.let/bin/hx</string>
      <string>watch</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key><false/>
    </dict>
    <key>ThrottleInterval</key><integer>60</integer>
    <key>ProcessType</key><string>Background</string>
    <key>LowPriorityBackgroundIO</key><true/>
    <key>Nice</key><integer>10</integer>
    <key>StandardOutPath</key><string>/Users/me/.let/hx/stdout.log</string>
    <key>StandardErrorPath</key><string>/Users/me/.let/hx/stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
"
`;

exports[`systemd: unit matches the snapshot 1`] = `
"# Managed by hx. hx start, hx update and the hx daemon rewrite this file, so local edits do not last.
# To override a setting, use a drop-in: systemctl --user edit hx-vision.service
[Unit]
Description=hx-vision session mirror
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/home/me/.let/bin/hx watch
Restart=always
RestartSec=60
Nice=10
IOSchedulingClass=idle
CPUWeight=20
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=512M
StandardOutput=append:/home/me/.let/hx/stdout.log
StandardError=append:/home/me/.let/hx/stderr.log

[Install]
WantedBy=default.target
"
`;

